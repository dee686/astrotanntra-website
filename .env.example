# ASTROTANNTRA - Real OTP & Email / SMS Service Configuration
# Add your keys here or enter them via the Settings button in the Auth dialog.

# 1. GOOGLE FIREBASE AUTHENTICATION (Recommended - Real Phone SMS to any mobile & Email to any address)
# Free project setup from https://console.firebase.google.com
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 2. GMAIL / EMAIL DELIVERY (Resend or EmailJS or Web3Forms)
# Free Resend API Key from https://resend.com (Recommended - 3,000 free emails/month):
VITE_RESEND_API_KEY=

# Or EmailJS from https://emailjs.com (200 free emails/month):
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Or Web3Forms Access Key from https://web3forms.com:
VITE_WEB3FORMS_KEY=

# 2. REAL PHONE SMS DELIVERY (Fast2SMS for India or Twilio for International)
# Free Fast2SMS API Key from https://fast2sms.com:
VITE_FAST2SMS_API_KEY=

# Or Twilio Credentials from https://twilio.com:
VITE_TWILIO_SID=
VITE_TWILIO_AUTH_TOKEN=
VITE_TWILIO_FROM_PHONE=
